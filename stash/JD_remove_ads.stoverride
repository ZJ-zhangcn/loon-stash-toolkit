name: "京东去广告"
desc: |-
  移除京东开屏广告，精简我的页面产品推广。
author: "RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png"
category: "去广告"
date: "2026-10-02 13:57:49"

http:
  mitm:
    - "api.m.jd.com"
  url-rewrite:
    - "^http:\\/\\/\\w{32}\\.jddebug\\.com\\/diagnose\\? - reject"
    - "^https:\\/\\/api\\.m\\.jd\\.com\\/client\\.action\\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) - reject-dict"
  body-rewrite:
    - "^https:\\/\\/api\\.m\\.jd\\.com\\/client\\.action\\?functionId=basicConfig response-json-replace data.JDMessage.socketmonitor.isSocketEstablishedAhead 0 data.JDMessage.socketmonitor.isSocketReport 0 data.JDHttpToolKit.httpdns.httpdns 0"
  script:
    - match: "^https:\\/\\/api\\.m\\.jd\\.com\\/client\\.action\\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)"
      name: "loon_jd_remove_ads_01"
      type: "response"
      require-body: true
script-providers:
  "loon_jd_remove_ads_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/JD/JD_remove_ads.js"
    interval: 86400
