name: "盒马开屏广告"
desc: |-
  移除盒马 App 启动开屏广告，仅处理 pageType=70 / poweron_ad 响应
author: "ZJ-zhangcn"
homepage: "https://github.com/ZJ-zhangcn/loon-stash-toolkit"
icon: "https://img.alicdn.com/imgextra/i1/O1CN017dUqIF1HSII6l0mr1_!!6000000000756-2-tps-265-265.png"
http:
  mitm:
    - "acs-m.freshippo.com"
  script:
    - match: "^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.render\\.querysinglepage\\/3\\.0\\/"
      name: "loon_freshippo_splash_01"
      type: "response"
      require-body: true
      timeout: 10
script-providers:
  "loon_freshippo_splash_01":
    url: "https://raw.githubusercontent.com/ZJ-zhangcn/loon-stash-toolkit/main/scripts/freshippo-splash.js"
    interval: 86400
