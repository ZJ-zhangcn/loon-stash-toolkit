name: "盒马去广告"
desc: |-
  移除开屏广告、首页信息流广告及推广、弹窗广告、悬浮挂件、商品及购物车推荐，精简底栏及我的页面。
author: "可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MrHema.png"
category: "去广告"
date: "2026-10-02 13:57:49"
http:
  mitm:
    - "acs-m.freshippo.com"
  url-rewrite:
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.render\\.querysinglepage\\/ - reject-dict"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.sg\\.queryinnerpage\\/ - reject-dict"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.lbs\\.address\\.getshopinfolist\\/ - reject-dict"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.render\\.querysearchpage\\/ - reject-dict"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.sg\\.querysinglescene\\/ - reject-dict"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.melon\\.collocation\\/ - reject-dict"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.fc\\.recommend\\.feedscommondservice\\/ - reject-dict"
  body-rewrite:
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.render\\.queryindexpage\\/ response-jq if .data.pageType == \"1\" then .data.scenes |= map(select(.bizCode == \"three_row_circle\")) else . end"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.render\\.querytabfeedstream\\/ response-jq if .data.pageType == \"5\" then .data.scenes |= map(select(.sceneType == \"100028\")) else . end"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/(mtop\\.wdk\\.render\\.querychannelpage|mtop\\.wdk\\.render\\.querysinglepage)\\/ response-jq if .data.pageType == \"216\" then .data.scenes |= map(select(.bizCode == \"shop_walk_top_picture\" or .bizCode == \"shop_walk_shop_util\" or .bizCode == \"shop_walk_bistro\")) else . end"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/mtop\\.wdk\\.render\\.querymypage\\/ response-jq .data.scenes |= map(select(.sceneType | IN(\"400029\", \"400005\", \"400010\", \"400002\", \"400004\", \"400015\")))"
    - "(?i)^https:\\/\\/acs-m\\.freshippo\\.com\\/gw\\/(mtop\\.wdk\\.lbs\\.location\\.shopdecideapi\\.decideformain|mtop\\.wdk\\.lbs\\.location\\.shopdecideapi\\.decidebygeocode)\\/ response-jq .data.groupList |= map(.ext.tabConfig |= (.normalTabList = (.normalTabList | map(select(.code as $c | [\"HOME\", \"CLASSIFY\", \"CART\", \"MY\"] | any(. == $c)))) | .normalTabListB = (.normalTabListB | map(select(.code as $c | [\"HOME\", \"CLASSIFY\", \"CART\", \"MY\"] | any(. == $c))))))"
