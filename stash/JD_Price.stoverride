name: "京东比价"
desc: |-
  首次使用需安装慢慢买应用，之后点击进入[我的]页面以捕获Cookie，捕获成功后方可在商品详情页面查看比价内容。
author: "wf021325[https://github.com/wf021325], githubdulong[https://github.com/githubdulong], mw418[https://github.com/mw418]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png"
category: "功能增强"
date: "2026-10-02 13:57:49"

http:
  mitm:
    - "in.m.jd.com"
    - "apapia-sqk-weblogic.manmanbuy.com"
  script:
    - match: "^https?:\\/\\/apapia-sqk-weblogic\\.manmanbuy\\.com\\/baoliao\\/center\\/menu$"
      name: "loon_jd_price_01"
      type: "request"
      require-body: true
      timeout: 10
    - match: "^https?:\\/\\/in\\.m\\.jd\\.com\\/product\\/graphext\\/\\d+\\.html"
      name: "loon_jd_price_02"
      type: "response"
      require-body: true
      timeout: 10
script-providers:
  "loon_jd_price_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/JD/JD_Price.js"
    interval: 86400
  "loon_jd_price_02":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/JD/JD_Price.js"
    interval: 86400
