name: "YouTube去广告"
desc: |-
  移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
author: "Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png"
category: "去广告"
date: "2026-10-02 13:57:49"
http:
  mitm:
    - "*.googlevideo.com"
    - "youtubei.googleapis.com"
  script:
    - match: "(?i)^https://youtubei\\.googleapis\\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\\?(.*))?$"
      name: "loon_youtube_remove_ads_01"
      type: "response"
      require-body: true
      binary-mode: true
      argument: "{\"blockUpload\":true,\"blockShorts\":true,\"blockImmersive\":true,\"captionLang\":\"zh-Hans\",\"debug\":false}"
    - match: "(?i)^https?://[\\w-]+\\.googlevideo\\.com/initplayback.+&ack.*"
      name: "loon_youtube_remove_ads_02"
      type: "request"
      require-body: true
      binary-mode: true
      argument: "{\"captionLang\":\"zh-Hans\"}"
    - match: "(?i)^https://youtubei\\.googleapis\\.com/youtubei/v1/log_event"
      name: "loon_youtube_remove_ads_03"
      type: "request"
      require-body: true
      binary-mode: true
      argument: "{\"blockUpload\":true,\"blockShorts\":true,\"blockImmersive\":true,\"captionLang\":\"zh-Hans\",\"debug\":false}"
script-providers:
  "loon_youtube_remove_ads_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js"
    interval: 86400
  "loon_youtube_remove_ads_02":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js"
    interval: 86400
  "loon_youtube_remove_ads_03":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js"
    interval: 86400
