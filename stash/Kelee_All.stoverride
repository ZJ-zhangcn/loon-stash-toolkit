      function deduplicateLivePhotos(livePhotos) {
        const seen = new Map();
        livePhotos = livePhotos.filter((item) => {
          if (seen.has(item.videId)) {
            return false;
          }
          seen.set(item.videId, true);
          return true;
        });
        return livePhotos;
      }

