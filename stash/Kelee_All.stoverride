                if (itemB?.file_id === itemA?.file_id && itemA?.url) {
                  itemA.url = itemA.url.replace(/^https?:\/\/.*\.mp4/g, itemB.url);
                }
              });
            });
          }
        } else {
          // 原始数据有问题 强制返回成功响应
