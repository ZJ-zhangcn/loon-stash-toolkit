name: "七猫小说去广告"
desc: |-
  移除大部分七猫小说广告，但受限于七猫小说自身对MitM和VPN状态的检测，部分页面广告无法移除。
author: "可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SevenCat.png"
category: "去广告"
date: "2026-10-02 13:57:49"
rules:
  - "DOMAIN, cdn-ad.wtzw.com, REJECT"
  - "DOMAIN, cdn-new-ad.wtzw.com, REJECT"
  - "DOMAIN-SUFFIX, gdt.qq.com, REJECT"
http:
  mitm:
    - "api-cfg.wtzw.com"
    - "sf3-fe-tos.pglstatp-toutiao.com"
    - "api-bc.wtzw.com"
    - "api-gw.wtzw.com"
    - "cdn.wtzw.com"
  url-rewrite:
    - "(?i)^https://api-cfg\\.wtzw\\.com/v\\d/splash/ - reject-dict"
    - "(?i)^https://api-bc\\.wtzw\\.com/api/v4/search/dispose - reject-dict"
    - "(?i)^https://api-bc\\.wtzw\\.com/api/v\\d/book-store/config - reject-dict"
    - "(?i)^https://api-bc\\.wtzw\\.com/api/v\\d/book-store/push-book - reject-dict"
    - "(?i)^https://api-bc\\.wtzw\\.com/api/v\\d/operation - reject-dict"
    - "(?i)^https://sf3-fe-tos\\.pglstatp-toutiao\\.com/obj/ad-pattern/ - reject"
    - "(?i)^https://api-gw\\.wtzw\\.com/welf/app/v\\d/task/red-packet - reject-dict"
    - "(?i)^https://cdn\\.wtzw\\.com/bookimg/free/api/v\\d/reader/reader-copy-paragraph-all\\.json - reject-dict"
    - "(?i)^https://api-cfg\\.wtzw\\.com/v\\d/reward/ - reject"
    - "(?i)^https://api-cfg\\.wtzw\\.com/v\\d/adv/ - reject"
    - "(?i)^https://api-cfg\\.wtzw\\.com/v\\d/offline-adv/index - reject-dict"
    - "(?i)^https://api-cfg\\.wtzw\\.com/v\\d/operation/index\\?ad_personal_switch - reject-dict"
    - "(?i)^https://xiaoshuo\\.wtzw\\.com/api/v\\d/withdraw/init - reject-dict"
  body-rewrite:
    - "(?i)^https://xiaoshuo\\.wtzw\\.com/api/v\\d/user/my-center\\? response-jq del(.data.func_area[1], .data.func_area[2])"
