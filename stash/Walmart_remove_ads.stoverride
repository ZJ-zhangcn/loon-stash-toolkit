name: "沃尔玛去广告"
desc: |-
  移除操作引导、商品详情页用户调研、搜索填充词和搜索发现，精简我的页面。
author: "可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Walmart.png"
category: "去广告"
date: "2026-10-02 13:57:49"
http:
  mitm:
    - "api-hyper.walmartmobile.cn"
  url-rewrite:
    - "(?i)^https://api-hyper\\.walmartmobile\\.cn/search/ad/ - reject-dict"
    - "(?i)^https://api-hyper\\.walmartmobile\\.cn/cms-web/frontapi/shadedWords/list\\? - reject-dict"
    - "(?i)^https://api-hyper\\.walmartmobile\\.cn/search/frontapi/discovery-words/list$ - reject-dict"
  body-rewrite:
    - "(?i)^https://api-hyper\\.walmartmobile\\.cn/cms-web/frontapi/common/page/get\\?.*&type=26$ response-jq .data |= (.moduleList | map(select(.templateCode == \"nav-bar-title\" or .templateCode == \"member-info\" or .templateCode == \"distribution-center\" or .templateCode == \"wallet\" or .templateCode == \"swiper\" or .templateCode == \"my-order\")))"
