name: "拼多多去广告"
desc: |-
  移除开屏广告、底栏多多视频、会场入口、聊天页面精选推荐及推广，精简首页和个人中心。
author: "ZenmoFeiShi[https://github.com/ZenmoFeiShi], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PinDuoDuo.png"
category: "去广告"
date: "2026-10-02 13:57:49"
rules:
  - "AND, ((URL-REGEX, \"^http:\\/\\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\/d(\\d)?\"), (USER-AGENT, \"*com.xunmeng.pinduoduo*\")), REJECT"
  - "AND, ((URL-REGEX, \"^http:\\/\\/\\[[0-9a-fA-F:]+\\]\\/d(\\d)?\\?\"), (USER-AGENT, \"*com.xunmeng.pinduoduo*\")), REJECT"
  - "AND, ((DOMAIN, api.pinduoduo.com), (PROTOCOL, QUIC)), REJECT"
  - "DOMAIN, titan.pinduoduo.com, REJECT"
  - "DOMAIN, xg.pinduoduo.com, REJECT"
  - "DOMAIN, cdl-1.pddpic.com, REJECT"
  - "DOMAIN, titan.pinduoduo.com, REJECT"
  - "DOMAIN, cdl-p2.pddpic.com, REJECT"
  - "DOMAIN, cd-1.pddpic.com, REJECT"
  - "DOMAIN, apm.pinduoduo.com, REJECT"
  - "DOMAIN, th-b.pinduoduo.com, REJECT"
  - "DOMAIN, ta.pinduoduo.com, REJECT"
  - "DOMAIN, th.pinduoduo.com, REJECT"
  - "DOMAIN, th-a.pinduoduo.com, REJECT"
  - "DOMAIN, ta-a.pinduoduo.com, REJECT"
  - "DOMAIN, meta.pinduoduo.com, REJECT"
  - "DOMAIN, apm-a.pinduoduo.com, REJECT"
http:
  mitm:
    - "api.pinduoduo.com"
    - "m.pinduoduo.net"
  url-rewrite:
    - "(?i)^https://api\\.pinduoduo\\.com/api/aristotle/unrated_order_for_unreceived_tab\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/aristotle/query_order_list_tabs_element\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/aquarius/hungary/global/homepage\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v3/query/order_express_group\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/search_hotquery\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/zaire_biz/chat/resource/get_list_data\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v3/query/new_chat_group\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/alexa/goods/back_up\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v3/query/personal\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/brand-olay/goods_detail/bybt_guide\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/engels/reviews/require/append\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v3/query/my_order_group\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v3/query/likes\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/phantom/gbdbpdv/extra\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/manufacturer/cross/shortcut/list\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/dunkirk/liveactivity/push/create/url/report\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/growth/nagato/app/index/gather\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/engels/wait/receive/review\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/buffon/nasus/recommend\\? - reject-dict"
    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v2/query/goods_detail_with_tags\\? - reject-dict"
  body-rewrite:
    - "(?i)^https://api\\.pinduoduo\\.com/api/alexa/homepage/hub\\? response-jq del(.result.dy_module.irregular_banner_dy, .result.icon_set, .result.search_bar_hot_query, .result.dy_module.irregular_banner_dy)"
    - "(?i)^https://api\\.pinduoduo\\.com/api/alexa/homepage/hub\\? response-jq .result.bottom_tabs? |= map(select(.link | IN(\"index.html\", \"chat_list.html\", \"personal.html\"))) | .result.buffer_bottom_tabs? |= map(select(.link | IN(\"index.html\", \"chat_list.html\", \"personal.html\"))) | .result.all_top_opts |= map(del(.selected_image, .image, .height, .width))"
    - "(?i)^https://api\\.pinduoduo\\.com/search\\? response-jq del(.expansion)"
    - "(?i)^https://api\\.pinduoduo\\.com/api/philo/personal/hub\\? response-jq del(.monthly_card_entrance, .personal_center_style_v2_vo, .icon_set.icons, .icon_set.top_personal_icons, .personal_banner)"
    - "(?i)^https://api\\.pinduoduo\\.com/api/oak/integration/render\\? response-jq del(.bottom_section_list, .ui.bottom_section, .ui.live_section.float_info)"
    - "(?i)^https://api\\.pinduoduo\\.com/api/caterham/v3/query/order_detail_group\\? response-jq del(.data.goods_list)"
    - "(?i)^https://api\\.pinduoduo\\.com/order/ response-jq del(.marketing_banner_vo, .shipping.banner_above_recommend)"
    - "(?i)^https://api\\.pinduoduo\\.com/api/aristotle/order_list_v4\\? response-jq .orders |= map(.order_buttons |= map(del(.order_growth_tip)))"
  script:
    - match: "(?i)^https://m\\.pinduoduo\\.net/mdkd/package\\?from_app_scan"
      name: "loon_pinduoduo_remove_ads_01"
      type: "response"
      require-body: true
script-providers:
# payload 为脚本快照，kelee.one 取不到脚本时的兜底
  "loon_pinduoduo_remove_ads_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/PinDuoDuo/PinDuoDuo_remove_ads.js"
    interval: 86400
    payload: |-
     /*
     https://t.me/ibilibili
     2026-07-11 20:05:34
     */
     let body = $response.body || "";
     
     const oldChunk = "https://pfile.pddpic.com/mdkd/mdkd/_next/static/chunks/9410-b8806e870a26db7d.js";
     const newChunk = "https://kelee.one/Resource/JavaScript/PinDuoDuo/9410-b8806e870a26db7d.js";
     
     function replaceAllText(text, from, to) {
       let pos = text.indexOf(from);
       while (pos !== -1) {
         text = text.slice(0, pos) + to + text.slice(pos + from.length);
         pos = text.indexOf(from, pos + to.length);
       }
       return text;
     }
     
     function removeGifContainer(html) {
       const marker = "index_gif-container";
       let pos = html.indexOf(marker);
     
       while (pos !== -1) {
         const open = html.lastIndexOf("<div", pos);
         if (open === -1) break;
     
         let i = open;
         let depth = 0;
         let end = -1;
     
         while (i < html.length) {
           const nextOpen = html.indexOf("<div", i);
           const nextClose = html.indexOf("</div>", i);
           if (nextClose === -1) break;
     
           if (nextOpen !== -1 && nextOpen < nextClose) {
             depth++;
             i = nextOpen + 4;
           } else {
             depth--;
             i = nextClose + 6;
             if (depth === 0) {
               end = i;
               break;
             }
           }
         }
     
         if (end === -1) break;
     
         html = html.slice(0, open) + html.slice(end);
         pos = html.indexOf(marker, open);
       }
     
       return html;
     }
     
     function trimNextData(html) {
       const idNeedle = 'id="__NEXT_DATA__"';
       const idPos = html.indexOf(idNeedle);
       if (idPos === -1) return html;
     
       const tagStart = html.lastIndexOf("<script", idPos);
       if (tagStart === -1) return html;
     
       const contentStart = html.indexOf(">", tagStart);
       if (contentStart === -1) return html;
     
       const tagEnd = html.indexOf("</script>", contentStart);
       if (tagEnd === -1) return html;
     
       const jsonText = html.slice(contentStart + 1, tagEnd);
     
       try {
         const data = JSON.parse(jsonText);
         const serverData = data &&
           data.props &&
           data.props.pageProps &&
           data.props.pageProps.serverData;
     
         if (Array.isArray(serverData)) {
           data.props.pageProps.serverData = serverData.filter(item =>
             item &&
             (item.key === "fastBindCMobilePreCheck" ||
              item.key === "queryStationPackageInfo")
           );
         }
     
         return html.slice(0, contentStart + 1) +
           JSON.stringify(data) +
           html.slice(tagEnd);
       } catch (e) {
         return html;
       }
     }
     
     body = replaceAllText(body, oldChunk, newChunk);
     body = removeGifContainer(body);
     body = trimNextData(body);
     
     $done({ body });
    payload: |-
      /*
      https://t.me/ibilibili
      2026-07-11 20:05:34
      */
      let body = $response.body || "";

      const oldChunk = "https://pfile.pddpic.com/mdkd/mdkd/_next/static/chunks/9410-b8806e870a26db7d.js";
      const newChunk = "https://kelee.one/Resource/JavaScript/PinDuoDuo/9410-b8806e870a26db7d.js";

      function replaceAllText(text, from, to) {
        let pos = text.indexOf(from);
        while (pos !== -1) {
          text = text.slice(0, pos) + to + text.slice(pos + from.length);
          pos = text.indexOf(from, pos + to.length);
        }
        return text;
      }

      function removeGifContainer(html) {
        const marker = "index_gif-container";
        let pos = html.indexOf(marker);

        while (pos !== -1) {
          const open = html.lastIndexOf("<div", pos);
          if (open === -1) break;

          let i = open;
          let depth = 0;
          let end = -1;

          while (i < html.length) {
            const nextOpen = html.indexOf("<div", i);
            const nextClose = html.indexOf("</div>", i);
            if (nextClose === -1) break;

            if (nextOpen !== -1 && nextOpen < nextClose) {
              depth++;
              i = nextOpen + 4;
            } else {
              depth--;
              i = nextClose + 6;
              if (depth === 0) {
                end = i;
                break;
              }
            }
          }

          if (end === -1) break;

          html = html.slice(0, open) + html.slice(end);
          pos = html.indexOf(marker, open);
        }

        return html;
      }

      function trimNextData(html) {
        const idNeedle = 'id="__NEXT_DATA__"';
        const idPos = html.indexOf(idNeedle);
        if (idPos === -1) return html;

        const tagStart = html.lastIndexOf("<script", idPos);
        if (tagStart === -1) return html;

        const contentStart = html.indexOf(">", tagStart);
        if (contentStart === -1) return html;

        const tagEnd = html.indexOf("</script>", contentStart);
        if (tagEnd === -1) return html;

        const jsonText = html.slice(contentStart + 1, tagEnd);

        try {
          const data = JSON.parse(jsonText);
          const serverData = data &&
            data.props &&
            data.props.pageProps &&
            data.props.pageProps.serverData;

          if (Array.isArray(serverData)) {
            data.props.pageProps.serverData = serverData.filter(item =>
              item &&
              (item.key === "fastBindCMobilePreCheck" ||
               item.key === "queryStationPackageInfo")
            );
          }

          return html.slice(0, contentStart + 1) +
            JSON.stringify(data) +
            html.slice(tagEnd);
        } catch (e) {
          return html;
        }
      }

      body = replaceAllText(body, oldChunk, newChunk);
      body = removeGifContainer(body);
      body = trimNextData(body);

      $done({ body });
