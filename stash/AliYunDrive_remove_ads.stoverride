name: "阿里云盘去广告"
desc: |-
  移除首页广告横幅、弹窗和顶部奖励。
author: "RuCu6[https://github.com/RuCu6]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/AliYunDrive.png"
category: "去广告"
date: "2026-10-02 13:57:49"
rules:
  - "IP-CIDR, 203.107.1.1/24, REJECT, no-resolve"
http:
  mitm:
    - "api.alipan.com"
    - "member.alipan.com"
    - "bizapi.alipan.com"
  url-rewrite:
    - "(?i)^https://member\\.alipan\\.com/v2/activity/sign_in_luckyBottle - reject-dict"
    - "(?i)^https://api\\.alipan\\.com/adrive/v1/file/getTopFolders - reject-dict"
  script:
    - match: "(?i)^https://(biz)?api\\.alipan\\.com/apps/v\\d/users?/home/(news|widgets)"
      name: "loon_aliyundrive_remove_ads_01"
      type: "response"
      require-body: true
    - match: "(?i)^https://member\\.alipan\\.com/v1/users/onboard_list"
      name: "loon_aliyundrive_remove_ads_02"
      type: "response"
      require-body: true
script-providers:
  "loon_aliyundrive_remove_ads_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/AliYunDrive/AliYunDrive_remove_ads.js"
    interval: 86400
  "loon_aliyundrive_remove_ads_02":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/AliYunDrive/AliYunDrive_remove_ads.js"
    interval: 86400
