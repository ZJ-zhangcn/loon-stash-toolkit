name: "阿里云盘去广告"
desc: |-
  移除首页广告横幅、弹窗和顶部奖励。
author: "RuCu6[https://github.com/RuCu6]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/AliYunDrive.png"
category: "去广告"
date: "2026-10-02 13:57:49"
rules:
  - "IP-CIDR, 203.107.1.1/24, REJECT, no-resolve"
http:
  mitm:
    - "api.alipan.com"
    - "member.alipan.com"
    - "bizapi.alipan.com"
  url-rewrite:
    - "(?i)^https://member\\.alipan\\.com/v2/activity/sign_in_luckyBottle - reject-dict"
    - "(?i)^https://api\\.alipan\\.com/adrive/v1/file/getTopFolders - reject-dict"
  script:
    - match: "(?i)^https://(biz)?api\\.alipan\\.com/apps/v\\d/users?/home/(news|widgets)"
      name: "loon_aliyundrive_remove_ads_01"
      type: "response"
      require-body: true
    - match: "(?i)^https://member\\.alipan\\.com/v1/users/onboard_list"
      name: "loon_aliyundrive_remove_ads_02"
      type: "response"
      require-body: true
script-providers:
# payload 为脚本快照，kelee.one 取不到脚本时的兜底
  "loon_aliyundrive_remove_ads_01":
    url: "https://git.repcz.link/kelee.one/Resource/JavaScript/AliYunDrive/AliYunDrive_remove_ads.js"
    interval: 86400
    payload: |-
     /*
     引用地址 https://raw.githubusercontent.com/RuCu6/QuanX/main/Scripts/adrive.js
     */
     // 2024-07-15 22:28:47
     
     const url = $request.url;
     if (!$response.body) $done({});
     let obj = JSON.parse($response.body);
     
     if (url.includes("/v1/users/onboard_list")) {
       if (obj.result?.length > 0) {
         obj.result = obj.result.filter(
           (i) =>
             ![
               "backup_list_under_mydevice_banner",
               "backup_top_banner",
               "home_bulletin_board",
               "home_top_banner",
               "resource_top_banner",
               "video_top_banner"
             ]?.includes(i?.anchor)
         );
       }
     } else if (url.includes("/v2/users/home/news")) {
       if (obj.result?.length > 0) {
         obj.result = obj.result.filter((i) => !i?.code?.includes("productUpdate"));
       }
     } else if (url.includes("/v1/user/home/widgets") || url.includes("/v2/users/home/widgets")) {
       const item = [
         // "album", // 相册
         "banners", // 顶部奖励
         // "coreFeatures", // 横版图标
         "introduceAlipan", // 认识阿里云盘
         "mainBackup", // 手机备份
         "minorBackup", // 备份设备列表
         // "signIn" // 签到
       ];
       item.forEach((i) => {
         delete obj[i];
       });
     }
     
     $done({ body: JSON.stringify(obj) });
    payload: |-
      /*
      引用地址 https://raw.githubusercontent.com/RuCu6/QuanX/main/Scripts/adrive.js
      */
      // 2024-07-15 22:28:47

      const url = $request.url;
      if (!$response.body) $done({});
      let obj = JSON.parse($response.body);

      if (url.includes("/v1/users/onboard_list")) {
        if (obj.result?.length > 0) {
          obj.result = obj.result.filter(
            (i) =>
              ![
                "backup_list_under_mydevice_banner",
                "backup_top_banner",
                "home_bulletin_board",
                "home_top_banner",
                "resource_top_banner",
                "video_top_banner"
              ]?.includes(i?.anchor)
          );
        }
      } else if (url.includes("/v2/users/home/news")) {
        if (obj.result?.length > 0) {
          obj.result = obj.result.filter((i) => !i?.code?.includes("productUpdate"));
        }
      } else if (url.includes("/v1/user/home/widgets") || url.includes("/v2/users/home/widgets")) {
        const item = [
          // "album", // 相册
          "banners", // 顶部奖励
          // "coreFeatures", // 横版图标
          "introduceAlipan", // 认识阿里云盘
          "mainBackup", // 手机备份
          "minorBackup", // 备份设备列表
          // "signIn" // 签到
        ];
        item.forEach((i) => {
          delete obj[i];
        });
      }

      $done({ body: JSON.stringify(obj) });
