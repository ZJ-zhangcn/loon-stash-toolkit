name: "招商银行开屏广告"
desc: |-
  移除招商银行 App 启动开屏广告配置，并兜底屏蔽 mbappinitads 素材
author: "ZJ-zhangcn"
homepage: "https://github.com/ZJ-zhangcn/loon-stash-toolkit"
icon: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTtSTa2igMJ-IX-ti3omujBaDZdQrTUIsBmVQ&s"
rules:
  - "URL-REGEX,^https:\\/\\/s3gw\\.cmbimg\\.cn\\/lr4504-mbappinitads-prd-1255000108\\/,REJECT"
http:
  mitm:
    - "webappcfg.paas.cmbchina.com"
    - "s3gw.cmbimg.cn"
  script:
    - match: "^https:\\/\\/webappcfg\\.paas\\.cmbchina\\.com\\/v1\\/func\\/getmarketconfig"
      name: "loon_cmb_startup_ad_01"
      type: "response"
      require-body: true
      timeout: 10
script-providers:
  "loon_cmb_startup_ad_01":
    url: "https://raw.githubusercontent.com/ZJ-zhangcn/loon-stash-toolkit/main/scripts/cmb-startup-ad.js"
    interval: 86400
