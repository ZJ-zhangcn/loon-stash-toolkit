name: "起点读书去广告"
desc: |-
  移除起点读书开屏广告、每日导读、各类弹窗、文末广告、搜索填充词，精简我的页面。
author: "可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]"
homepage: "https://hub.kelee.one"
icon: "https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/QiDian.png"
category: "去广告"
date: "2026-10-02 13:57:49"
http:
  mitm:
    - "magev6.if.qidian.com"
    - "ywab.reader.qq.com"
  url-rewrite:
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v4\\/client\\/getsplashscreen\\? - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/adv\\/ - reject-dict"
    - "(?i)^https:\\/\\/ywab\\.reader\\.qq\\.com\\/user\\/experiments\\/v2\\? - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/checkin\\/simpleinfo\\? - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/push\\/getdialog\\? - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/message\\/getpushedmessagelist$ - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/maintain\\/playstrip$ - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/dailyrecommend\\/recommendBook\\? - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/freshman\\/bookshelfbtn$ - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/bookshelf\\/getTopOperation$ - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/booksearch\\/hotWords\\? - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/followsubscribe\\/showChapterEndModule\\? - reject-dict"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/young\\/getconf$ - reject-dict"
  body-rewrite:
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/client\\/getconf$ response-jq (.Data.WolfEye = 0) | (.Data.CloudSetting.TeenShowFreq = 0)"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v1\\/client\\/getconf$ response-jq del(.Data.ActivityPageBackPushNoticeFrequency, .Data.ActivityIcon, .Data.ActivityPopup, .Data.LuckBag)"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v2\\/dailyrecommend\\/getdailyrecommend\\? response-jq (.Data.Items = [])"
    - "(?i)^https:\\/\\/magev6\\.if\\.qidian\\.com\\/argus\\/api\\/v3\\/user\\/getaccountpage\\? response-jq del(.Data.BenefitButtonList)"
